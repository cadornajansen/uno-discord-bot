# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
DEV_GUILD_ID=your_test_server_id_here

# Logging (set LOG_FILE path to enable persistent log file, e.g. logs/uno.log)
# Leave blank to log to console only (default)
LOG_FILE=

# AssemblyAI LLM Gateway (Gemini 3.5 Flash)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
ASSEMBLYAI_LLM_BASE_URL=https://llm-gateway.assemblyai.com/v1
ASSEMBLYAI_LLM_MODEL=gemini-3.5-flash
ASSEMBLYAI_LLM_TIMEOUT_SECONDS=60.0
ASSEMBLYAI_LLM_MAX_TOKENS=1000

# Google Gemini Embeddings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_EMBEDDING_TIMEOUT_SECONDS=30.0

# Vector Store (Qdrant) Configuration
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=discord_messages_gemini_v1

# Knowledge Ingestion Settings
# Comma-separated channel IDs eligible for indexing (e.g., 123456789012345678,987654321098765432)
# IF LEFT EMPTY, NO MESSAGES WILL BE INDEXED.
INDEXED_CHANNEL_IDS=
# Trusted channels consulted for current homework and announcements.
ASSIGNMENT_CHANNEL_IDS=1531615193786876064,1531615193786876063

# RAG Integration Settings
RAG_TOP_K=5
RAG_MIN_SCORE=0.50
RAG_MAX_CONTEXT_RESULTS=3

# Per-user chat memory and agent tool limits
CHAT_MEMORY_MAX_TURNS=4
CHAT_MEMORY_TTL_MINUTES=30
CHAT_MEMORY_MAX_TOKENS=1200
CHAT_MAX_TOOL_ROUNDS=2

# Serper Search Configuration
SERPER_API_KEY=
SERPER_BASE_URL=https://google.serper.dev
SEARCH_RESULT_LIMIT=5

# Document Analysis Configuration
DOCUMENT_MAX_SIZE_MB=15
DOCUMENT_MAX_CHARS=20000
DOCUMENT_SESSION_TTL_MINUTES=30

# Academic Schedule Configuration
ACADEMIC_SCHOOL_YEAR=2026-2027
ACADEMIC_SEMESTER=1
ACADEMIC_TIMEZONE=Asia/Manila

# Weather Configuration (PLM / Manila Default Coordinates)
# Public campus coordinates (Pamantasan ng Lungsod ng Maynila)
WEATHER_LATITUDE=14.5869
WEATHER_LONGITUDE=120.9762
WEATHER_LOCATION_NAME=Manila (PLM)
WEATHER_TIMEZONE=Asia/Manila

# PAGASA NCR-PRSD Forecast & Warnings URL
PAGASA_NCR_URL=https://www.pagasa.dost.gov.ph/regional-forecast/ncrprsd

# Image OCR Ingestion Settings (Homework Channels)
# Comma-separated channel IDs eligible for image OCR (must also be listed in INDEXED_CHANNEL_IDS)
OCR_CHANNEL_IDS=
OCR_MAX_IMAGE_MB=8
OCR_MIN_TEXT_CHARS=10
OCR_MAX_IMAGES_PER_MESSAGE=3
